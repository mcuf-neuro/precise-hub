# PRECISE Hub - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Forschungsspeicher (UKF local research storage, CIFS/AD) ---
LDAP_USERNAME=''
LDAP_PASSWORD=''
LDAP_PATH=''
# Example: LDAP_PATH='//ad.example.com/Group'

# --- Data Exchange Gateway (DEG, WebDAV) ---
WEBDAV_USERNAME=''
WEBDAV_PASSWORD=''
WEBDAV_PATH=''
# Example: WEBDAV_PATH='https://deg.example.com/adminview/'

# --- Data Lake (TrueNAS, CIFS) ---
TRUENAS_USERNAME=''
TRUENAS_PASSWORD=''
TRUENAS_PATH=''
# Example: TRUENAS_PATH='//nas.example.com/share/path'
